# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# LLM API (OpenAI-совместимый: OpenRouter, DeepSeek, OpenAI, и т.д.)
# OpenRouter (рекомендуется, работает из РФ): https://openrouter.ai/keys
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat-v3-0324

# Или DeepSeek напрямую:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Или OpenAI:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Путь к модели Vosk (опционально, без неё используется Google SR онлайн)
VOSK_MODEL_PATH=models/vosk-model-ru-0.54

# TTS движок: "silero" (офлайн, русский) или "edge" (онлайн)
TTS_ENGINE=silero
TTS_VOICE=xenia
TTS_RATE=+0%
TTS_PITCH_SEMITONES=-4

# Имя бота
BOT_NAME=Хулио

# Файл личности (из папки personalities/)
PERSONALITY_FILE=personalities/default.txt
