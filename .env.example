# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (https://aistudio.google.com/apikey) — бесплатно
GEMINI_API_KEY=your_gemini_api_key_here

# Путь к модели Vosk (скачать: https://alphacephei.com/vosk/models)
# Для русского: vosk-model-small-ru-0.22 (маленькая, быстрая)
# Для английского: vosk-model-small-en-us-0.15
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22

# Голос Edge TTS (список: edge-tts --list-voices)
# Русские голоса: ru-RU-DmitryNeural, ru-RU-SvetlanaNeural
# Английские: en-US-GuyNeural, en-US-JennyNeural
TTS_VOICE=ru-RU-DmitryNeural

# Скорость речи TTS (например +10%, -5%)
TTS_RATE=+0%

# Имя бота (как к нему обращаться)
BOT_NAME=Хулио

# Файл личности (из папки personalities/)
PERSONALITY_FILE=personalities/default.txt
