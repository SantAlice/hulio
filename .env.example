# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# LLM API (OpenAI-совместимый: DeepSeek, OpenAI, и т.д.)
# DeepSeek (работает из РФ): https://platform.deepseek.com/api_keys
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Или OpenAI:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Или Gemini (не работает из РФ):
# GEMINI_API_KEY=your_gemini_key
# (автоматически настроит base_url и модель)

# Путь к модели Vosk (опционально, без неё используется Google SR онлайн)
VOSK_MODEL_PATH=models/vosk-model-ru-0.54

# TTS движок: "silero" (офлайн, русский) или "edge" (онлайн)
TTS_ENGINE=silero
TTS_VOICE=xenia
TTS_RATE=+0%
TTS_PITCH_SEMITONES=-4

# Имя бота
BOT_NAME=Хулио

# Файл личности (из папки personalities/)
PERSONALITY_FILE=personalities/default.txt
